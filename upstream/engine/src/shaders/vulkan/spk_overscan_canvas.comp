#version 450
#extension GL_GOOGLE_include_directive : require
// spk_overscan_canvas.comp -- GLSL translation of `spk_overscan_canvas` in
// overscan.metal (RFC-032 §26-§27): ①+② the gate's shadow on the emulsion and
// the frame's own exposure, plus ③ the fog/leaks, as raw exposure on the film
// canvas. Transferred verbatim; only Metal -> GLSL spelling changed.
layout(local_size_x = 256) in;

#include "spk_overscan.glsl"

layout(std430, binding = 0) readonly buffer Frame { float frame[]; };
layout(std430, binding = 2) readonly buffer Count { uint n[]; };
layout(std430, binding = 3) writeonly buffer Out { float outb[]; };
// [DEYVA-DIAG v0.8.88] Probe echo: for the 5 gate probe canvas pixels (passed
// in n[1..10] as (x,y) pairs) the shader writes the (fx, fy) it actually
// computes, so the panel can compare the GPU's mapping with the CPU's
// prediction. 15 floats = 5 * (fx, fy, in-range flag).
layout(std430, binding = 4) writeonly buffer ProbeOut { float po[]; };

int probe_index(uint i, uint cw) {
    const uint x = i % cw, y = i / cw;
    for (int k = 0; k < 5; ++k) {
        if (n[1 + 2*k] == x && n[2 + 2*k] == y) return k;
    }
    return -1;
}

// Bilinear sample of the frame at (fx, fy), clamped to the frame.
vec3 sample_frame(float fx, float fy) {
    const uint fw = uint(P[P_FW]), fh = uint(P[P_FH]);
    fx = clamp(fx, 0.0, float(fw) - 1.0);
    fy = clamp(fy, 0.0, float(fh) - 1.0);
    const uint x0 = uint(floor(fx)), y0 = uint(floor(fy));
    const uint x1 = min(x0 + 1u, fw - 1u), y1 = min(y0 + 1u, fh - 1u);
    const float ax = fx - float(x0), ay = fy - float(y0);
    const uint i00 = 3u * (y0 * fw + x0), i01 = 3u * (y0 * fw + x1);
    const uint i10 = 3u * (y1 * fw + x0), i11 = 3u * (y1 * fw + x1);
    const vec3 a = vec3(frame[i00], frame[i00+1u], frame[i00+2u]);
    const vec3 b = vec3(frame[i01], frame[i01+1u], frame[i01+2u]);
    const vec3 c = vec3(frame[i10], frame[i10+1u], frame[i10+2u]);
    const vec3 d = vec3(frame[i11], frame[i11+1u], frame[i11+2u]);
    return mix(mix(a, b, ax), mix(c, d, ax), ay);
}

void main() {
    // [DEYVA-FIX v0.8.89] The host may dispatch the canvas in several small
    // sequential sub-dispatchs (Adreno 830 drops writes in the high half of a
    // single large dispatch), so the absolute canvas pixel is n[11] (base) +
    // the local invocation id; n[0] is this chunk's pixel count.
    const uint i = n[11] + spk_global_index();
    if (i >= n[11] + n[0]) return;
    const uint cw = uint(P[P_CW]);
    const vec2 st = canvas_to_film(float(i % cw), float(i / cw));
    // [DEYVA-DIAG v0.8.88] Echo the raw mapping (before coverage) at the 5
    // probe pixels so the panel can compare the GPU's fx/fy with the CPU's.
    {
        const int probe = probe_index(i, cw);
        if (probe >= 0) {
            const float px = P[P_PX];
            const float fw = P[P_FW], fh = P[P_FH];
            const float gw = P[P_GW] / px, gh = P[P_GH] / px;
            float fx, fy;
            if (P[P_VERTICAL] < 0.5) {
                fx = (st.x - P[P_GS0]) / px - 0.5 + 0.5 * (fw - gw);
                fy = (st.y - P[P_GT0]) / px - 0.5 + 0.5 * (fh - gh);
            } else {
                fx = (P[P_GT0] + P[P_GH] - st.y) / px - 0.5 + 0.5 * (fw - gh);
                fy = (st.x - P[P_GS0]) / px - 0.5 + 0.5 * (fh - gw);
            }
            po[3 * probe] = fx;
            po[3 * probe + 1] = fy;
            po[3 * probe + 2] = (fx >= 0.0 && fx < fw && fy >= 0.0 && fy < fh) ? 1.0 : 0.0;
        }
    }
    const float W = P[P_FILM_W];
    vec3 e = vec3(0.0);
    if (P[P_CARRIER] > 1.5 || (st.y >= 0.0 && st.y <= W)) {
        vec2 sg = st;
        float shift = 0.0;
        if (P[P_PAIR_ADV] > 0.0 && st.x > P[P_GS0] + 0.5 * (P[P_GW] + P[P_PAIR_ADV])) { shift = P[P_PAIR_ADV]; sg.x -= shift; }
        const float cov = penumbra(gate_sdf(sg), P[P_PENUMBRA]);
        if (cov > 0.0) {
            const float px = P[P_PX];
            // [DEYVA-FIX v0.8.84] Show the photo at its own resolution (1:1),
            // centred on the gate centre, instead of resampling it up to the
            // gate's physical pixel count (the photo was being magnified ~3.5x,
            // which the user asked to stop). Pixels of the gate outside the
            // photo's footprint read no scene light, so the gate's blank area
            // stays the film's own (dark) exposure rather than a stretched edge.
            const float fw = P[P_FW], fh = P[P_FH];
            const float gw = P[P_GW] / px, gh = P[P_GH] / px;
            float fx, fy;
            if (P[P_VERTICAL] < 0.5) {
                fx = (st.x - P[P_GS0]) / px - 0.5 + 0.5 * (fw - gw);
                fy = (st.y - P[P_GT0]) / px - 0.5 + 0.5 * (fh - gh);
            } else {
                fx = (P[P_GT0] + P[P_GH] - st.y) / px - 0.5 + 0.5 * (fw - gh);
                fy = (st.x - P[P_GS0]) / px - 0.5 + 0.5 * (fh - gw);
            }
            // [DEYVA-FIX v0.8.88] Strict half-open bounds: the photo's pixel
            // indices are [0, fw) x [0, fh). fx == fw (or fy == fh) is the pixel
            // just past the frame and must be dropped; fx in [fw-1, fw) is the
            // frame's last column/row and is valid (sample_frame clamps to
            // fw-1 for the bilinear taps). The old `<= fw-1` / `<= fh-1`
            // wrongly dropped that last half-column/half-row to background.
            if (fx >= 0.0 && fx < fw && fy >= 0.0 && fy < fh)
                e += cov * sample_frame(fx, fy);
        }
        // Gate flare: the gate's bevelled edge reflects scene light just
        // outside the frame -- a thin line that follows the scene's brightness.
        const float d_gate = gate_sdf(sg);
        if (P[P_FLARE_AMP] > 0.0 && d_gate > -0.02 && d_gate < 6.0 * P[P_FLARE_WIDTH]) {
            const float px = P[P_PX];
            const float in_s = clamp(sg.x, P[P_GS0] + 0.12, P[P_GS0] + P[P_GW] - 0.12) + shift;
            const float in_t = clamp(st.y, P[P_GT0] + 0.12, P[P_GT0] + P[P_GH] - 0.12);
            float fx, fy;
            if (P[P_VERTICAL] < 0.5) { fx = (in_s - P[P_GS0]) / px - 0.5; fy = (in_t - P[P_GT0]) / px - 0.5; }
            else                      { fx = (P[P_GT0] + P[P_GH] - in_t) / px - 0.5; fy = (in_s - P[P_GS0]) / px - 0.5; }
            const vec3 edge_light = sample_frame(fx, fy);
            const float prof = exp(-max(d_gate, 0.0) / P[P_FLARE_WIDTH]);
            e += P[P_FLARE_AMP] * prof * edge_light;
        }
        // Edge fog: warm exposure decaying inward from each long edge, slowly
        // varying along the length; and the spool leaks.
        const float d_top = max(st.y, 0.0), d_bot = max(W - st.y, 0.0);
        const uint seed = uint(P[P_FOG_SEED]);
        const float period = max(P[P_FOG_PERIOD], 0.1);
        const float nz = 0.6 * value_noise(st.x / period, seed) +
                         0.4 * value_noise(st.x / (0.37 * period), seed ^ 0xA5A5A5A5u);
        float fog = P[P_FOG_AMP] * exp(-min(d_top, d_bot) / max(P[P_FOG_WIDTH], 1e-3)) * (0.3 + 0.7 * nz);
        const uint nl = uint(P[P_N_LEAKS]);
        for (uint k = 0u; k < nl; ++k) {
            const uint b = uint(P_LEAKS) + 5u * k;
            const float dd = P[b + 1u] < 0.5 ? d_top : d_bot;
            const float ds = st.x - P[b];
            fog += P[b + 2u] * exp(-ds * ds / (2.0 * P[b + 3u] * P[b + 3u])) * exp(-dd / P[b + 4u]);
        }
        e += fog * vec3(P[P_FOG_R], P[P_FOG_G], P[P_FOG_B]);
    }
    outb[3u * i] = e.x;
    outb[3u * i + 1u] = e.y;
    outb[3u * i + 2u] = e.z;
}
