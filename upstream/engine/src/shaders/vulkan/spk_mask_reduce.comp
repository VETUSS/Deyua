#version 450
#extension GL_GOOGLE_include_directive : require
// spk_mask_reduce.comp -- GLSL translation of `spk_mask_reduce` in
// contrast_mask.metal (RFC-024 §8).
//
// The analysis: one thread per grid cell, the mean of `x` over the cell's
// pixels. The cells partition the frame (`[cx*W/gw, (cx+1)*W/gw)`), so every
// pixel is counted exactly once whatever the tier's size. The result is the
// canonical grid the host blurs into the mask's base.
layout(local_size_x = 256) in;

#include "spk_mask.glsl"

layout(std430, binding = 5) readonly buffer Meta { uint meta[]; };
layout(std430, binding = 6) writeonly buffer Out { float mask_out[]; };

void main() {
    const uint cell = spk_global_index();
    const uint W = meta[0], H = meta[1], gw = meta[2], gh = meta[3], nl = meta[4];
    if (cell >= gw * gh) return;
    const uint cy = cell / gw, cx = cell % gw;
    const uint x0 = (cx * W) / gw;
    uint x1 = max(((cx + 1u) * W) / gw, x0 + 1u);
    const uint y0 = (cy * H) / gh;
    uint y1 = max(((cy + 1u) * H) / gh, y0 + 1u);
    x1 = min(x1, W);
    y1 = min(y1, H);
    float acc = 0.0;
    for (uint y = y0; y < y1; ++y)
        for (uint x = x0; x < x1; ++x)
            acc += mask_x(mask_image_exposure(y * W + x, nl));
    mask_out[cell] = acc / float((x1 - x0) * (y1 - y0));
}
