#version 450
#extension GL_GOOGLE_include_directive : require
// spk_overscan_light.comp -- GLSL translation of `spk_overscan_light` in
// overscan.metal (RFC-032 §30.5, §31): the scan's view of the holes. Inside a
// hole the picture's own white (holes=white) or a black backing; around it the
// cut wall, a faint olive-warm band; and a faint flare into the film on some
// holes. Linear output RGB after the scanner's blur/sharpening.
layout(local_size_x = 256) in;

#include "spk_overscan.glsl"

layout(std430, binding = 0) readonly buffer Rgb { float rgb[]; };
layout(std430, binding = 2) readonly buffer Count { uint n[]; };
layout(std430, binding = 3) writeonly buffer Out { float outb[]; };

void main() {
    const uint i = spk_global_index();
    if (i >= n[0]) return;
    const uint cw = uint(P[P_CW]);
    const vec2 st = canvas_to_film(float(i % cw), float(i / cw));
    const float a = film_alpha(st);
    const bool white = P[P_HOLES_LIGHT] > 0.5;
    vec3 light = vec3(P[P_LIGHT_R], P[P_LIGHT_G], P[P_LIGHT_B]);
    vec3 c = vec3(rgb[3u * i], rgb[3u * i + 1u], rgb[3u * i + 2u]);
    if (P[P_PERFORATED] > 0.5) {
        uint hole;
        const float d = perf_sdf(st, hole);
        const uint seed = uint(P[P_PERF_SEED]);
        const int h = int(hole & 0xFFFFu);
        if (d > -0.03 && d < 0.15) {
            const float e = 0.003;
            uint hh;
            const vec2 g = vec2(perf_sdf(st + vec2(e, 0.0), hh) - perf_sdf(st - vec2(e, 0.0), hh),
                                perf_sdf(st + vec2(0.0, e), hh) - perf_sdf(st - vec2(0.0, e), hh));
            const vec2 nrm = g / max(length(g), 1e-6);
            const vec2 vdir = vec2(P[P_WALL_VS], P[P_WALL_VT]);
            // how much this stretch of this hole's outline shows: per hole, patchy
            // along the outline, a little more on the side the scan leans to
            const float per_hole = 0.4 + 0.6 * hash_f(h, seed ^ 0xE1u);
            const float patc = smoothstep(0.25, 0.75, 0.5 * (value_noise(st.x / 0.35, seed ^ uint(h)) +
                                                            value_noise(st.y / 0.35, seed ^ uint(h) ^ 0x3Cu)));
            const float side = 0.6 + 0.8 * max(0.0, dot(nrm, vdir));
            const float k = per_hole * patc * side;
            // the base's tint, mostly washed out
            const vec3 tint = mix(vec3(1.0), vec3(P[P_BASE_R], P[P_BASE_G], P[P_BASE_B]), 0.3);
            const float lam = P[P_WALL_SCATTER];
            if (d >= 0.0) {
                const float lift = P[P_WALL_GLOW] * k * exp(-d / lam);
                c += lift * tint * (white ? light : vec3(1.0));
            } else if (white && hash_f(h, seed ^ 0xE4u) < 0.5) {
                light *= 1.0 - 0.12 * k * (1.0 - tint) * exp(d / 0.012);
            }
        }
        if (white && d >= 0.0) {
            const float fl = 0.012 * hash_f(h, seed ^ 0xC4u) * step(0.5, hash_f(h, seed ^ 0xC5u));
            c += fl * exp(-d / 0.025) * light;
        }
    }
    // Past the film's long edges is the scan's carrier, not a hole: black, or
    // the scan's open light.
    const float W = P[P_FILM_W], px = P[P_PX];
    const float on_strip = P[P_CARRIER] > 1.5 ? 1.0 : clamp(min(st.y, W - st.y) / px + 0.5, 0.0, 1.0);
    const float in_film = on_strip > 0.0 ? a / on_strip : 0.0;
    const vec3 r3 = mix(vec3(P[P_CARRIER]), mix(light, c, in_film), on_strip);
    outb[3u * i] = r3.x;
    outb[3u * i + 1u] = r3.y;
    outb[3u * i + 2u] = r3.z;
}
