<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 写相册导出（API 24–28 需要；29+ 走 scoped storage 免权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 刻度条跨刻度触觉震动（无此权限 vibrate() 会抛 SecurityException 闪退） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 检查更新：读取 GitHub Release 的 JSON 并下载安装包 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- [r62] 应用内更新：调起系统包安装器。安装仍需用户在系统设置里
         为本应用打开"安装未知应用"，这条权限只声明意图，不代表可以静默安装。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Deyva"
        android:theme="@style/Theme.Deyva"
        android:largeHeap="true"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|colorMode"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- [r48] 出现在系统分享面板：相册里选一张照片 → 分享 → Deyva，
                 省掉"打开 app、导入、在系统相册里再找一遍"。
                 singleTask 保证不会因为反复分享而在同一个任务里堆出好几个实例
                 （每个实例都带一份引擎），第二次分享走 onNewIntent。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <!-- 供"导出并共享"临时文件分享 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
